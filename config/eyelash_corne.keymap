#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/eyelash42.h"
#include "labels.h"

#define BASE 0
#define NUM 1
#define NAV 2
#define SYS 3
#define SYM 4
#define MOUSE 5
#define MOUSESLOW 6
#define MOUSEFAST 7

#define ___ &trans

&soft_off { hold-time-ms = <2000>; };

&mmv_input_listener {
    MOUSESLOW {
        layers = <MOUSESLOW>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
    MOUSEFAST {
        layers = <MOUSEFAST>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

&msc_input_listener {
    MOUSESLOW {
        layers = <MOUSESLOW>;
        input-processors = <&zip_scroll_scaler 1 3>;
    };
    MOUSEFAST {
        layers = <MOUSEFAST>;
        input-processors = <&zip_scroll_scaler 3 1>;
    };
};

ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    require-prior-idle-ms = <100>;
    tapping-term-ms = <190>;
    quick-tap-ms = <300>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    require-prior-idle-ms = <100>;
    tapping-term-ms = <190>;
    quick-tap-ms = <300>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

ZMK_HOLD_TAP(thumb,
    flavor = "balanced";
    tapping-term-ms = <200>;
    bindings = <&mo>, <&kp>;
    quick-tap-ms = <250>;
)

ZMK_TAP_DANCE(td_media,
    bindings = <&kp C_PP>, <&kp C_NEXT>, <&kp C_PREV>;
    tapping-term-ms = <1000>;
)

ZMK_TAP_DANCE(bt_0, bindings = <&bt_select_0>, <&bt BT_DISC 0>;)
ZMK_TAP_DANCE(bt_1, bindings = <&bt_select_1>, <&bt BT_DISC 1>;)
ZMK_TAP_DANCE(bt_2, bindings = <&bt_select_2>, <&bt BT_DISC 2>;)
ZMK_TAP_DANCE(bt_3, bindings = <&bt_select_3>, <&bt BT_DISC 3>;)

ZMK_MACRO(bt_select_0, bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;)
ZMK_MACRO(bt_select_1, bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;)
ZMK_MACRO(bt_select_2, bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;)
ZMK_MACRO(bt_select_3, bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;)

ZMK_MACRO_ONE_PARAM(mod_tab_layer,
    bindings
        = <&macro_press &mo NAV>,
          <&macro_param_1to1>,
          <&macro_press &kp MACRO_PLACEHOLDER>,
          <&macro_tap &kp TAB>,
          <&macro_pause_for_release>,
          <&macro_param_1to1>,
          <&macro_release &kp MACRO_PLACEHOLDER>,
          <&macro_release &mo NAV>;
)

ZMK_COMBO(softoff, &soft_off, LT4 LM3 LB4)

// Alt+Tab: hold both keys to keep NAV+Alt engaged (NAV layer has TAB
// bound too, so you can keep tapping it while holding this combo down).
ZMK_COMBO(alttab_cursor, &mod_tab_layer LALT, LH1 LH2)

ZMK_COMBO(caps_word, &caps_word, LB5 RB5)

// Physical layout (see zmk-helpers/key-labels/eyelash42.h for the position map):
//
//  LT5 LT4 LT3 LT2 LT1 LT0          JS0      RT0 RT1 RT2 RT3 RT4 RT5
//  LM5 LM4 LM3 LM2 LM1 LM0      JS1 JS2 JS3  RM0 RM1 RM2 RM3 RM4 RM5
//  LB5 LB4 LB3 LB2 LB1 LB0  LEC     JS4      RB0 RB1 RB2 RB3 RB4 RB5
//          LH2 LH1 LH0                       RH0 RH1 RH2
//
// JS0-4 = joystick; LEC = scroller/encoder push
ZMK_LAYER(base,
&kp TAB   &kp Q       &kp W       &kp E        &kp R        &kp T                          &kp UP                   &kp Y  &kp U         &kp I         &kp O        &kp P           &kp BSLH
&kp ESC   &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G                &kp LEFT  &kp ENTER  &kp RIGHT     &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
&kp LSHFT &kp Z       &kp X       &kp C        &kp V        &kp B     &td_media            &kp DOWN                 &kp N  &kp M         &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT
                      &caps_word &thumb NAV SPACE &thumb SYS TAB                                                   &thumb SYM RET &thumb NUM BSPC &thumb MOUSE DEL
, &inc_dec_kp C_VOL_UP C_VOL_DN
)

ZMK_LAYER(number,
___ &kp LBKT   &kp N7 &kp N8 &kp N9 &kp RBKT                             ___                   &none  &none      &none      &none     &none    &none
___ &kp MINUS  &kp N4 &kp N5 &kp N6 &kp EQUAL                     ___    ___    ___            &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI &none
___ &kp GRAVE  &kp N1 &kp N2 &kp N3 &kp BSLH           ___               ___                   &none  &none      &none      &none     &none    &none
                       &kp DOT &kp N0 &kp MINUS                                                   ___  ___  ___
)

ZMK_LAYER(nav,
&none     &kp LC(A) &kp SPACE &kp TAB   &kp BSPC  &none                                 ___              &kp LC(X)  &kp LS(TAB)  &kp LC(Z)  &kp LC(Y)  &kp TAB   &none
&none     &kp LGUI  &kp LALT  &kp LCTRL &kp LSHFT &none                          ___    ___    ___       &kp LEFT   &kp DOWN     &kp UP     &kp RIGHT  &kp CAPS  &none
&kp LC(L) &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(LS(V))          ___            ___              &kp LC(V)  &kp HOME     &kp PG_UP  &kp PG_DN  &kp END   &kp LC(L)
                              ___ ___ ___                                                                   ___ ___ ___
)

ZMK_LAYER(sys,
&bootloader    &kp C_BRI_UP &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &sys_reset                   ___             &kp PAUSE_BREAK &kp F7 &kp F8 &kp F9 &kp F10 &bootloader
&studio_unlock &kp C_BRI_DN &kp C_PREV &kp C_PP     &kp C_NEXT   &kp PSCRN             ___    ___    ___      &kp PSCRN       &kp F4 &kp F5 &kp F6 &kp F11 ___
___            &bt_0        &bt_1      &bt_2        &bt_3        &out OUT_USB  ___            ___             &kp SLCK        &kp F1 &kp F2 &kp F3 &kp F12 ___
                                              ___ ___ ___                                                           ___ ___ ___
)

ZMK_LAYER(symbol,
___ &kp LBRC  &kp AMPS &kp STAR  &kp LPAR  &kp RBRC                         ___              &none  &none      &none      &none     &none    &none
___ &kp UNDER &kp DLLR &kp PRCNT &kp CARET &kp PLUS                  ___    ___    ___       &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI &none
___ &kp TILDE &kp EXCL &kp AT    &kp HASH  &kp PIPE          ___            ___              &none  &none      &none      &none     &none    &none
                       &kp LPAR &kp RPAR &kp UNDER                                                ___  ___  ___
)

ZMK_LAYER(mouse,
___ ___            &msc SCRL_LEFT &mmv MOVE_UP   &msc SCRL_RIGHT ___                                         &mmv MOVE_UP                     ___      &mo MOUSESLOW &mo MOUSEFAST ___      ___      ___
___ &msc SCRL_UP   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &mkp MB5                    &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT       &mkp MB5 &sk RSHFT     &sk RCTRL     &sk RALT &sk RGUI ___
___ &msc SCRL_DOWN &none          &mo MOUSESLOW  &mo MOUSEFAST   &mkp MB4       &mkp RCLK                    &mmv MOVE_DOWN                   &mkp MB4 &mkp LCLK     &mkp MCLK     &mkp RCLK ___     ___
                                  &mkp MCLK &mkp LCLK &mkp RCLK                                                                                    ___ ___ ___
)

ZMK_LAYER(mouse_slow,
___ ___ ___ ___ ___ ___                    ___               ___ ___ ___ ___ ___ ___
___ ___ ___ ___ ___ ___             ___    ___    ___        ___ ___ ___ ___ ___ ___
___ ___ ___ ___ ___ ___     ___            ___               ___ ___ ___ ___ ___ ___
            ___ ___ ___                                          ___ ___ ___
)

ZMK_LAYER(mouse_fast,
___ ___ ___ ___ ___ ___                    ___               ___ ___ ___ ___ ___ ___
___ ___ ___ ___ ___ ___             ___    ___    ___        ___ ___ ___ ___ ___ ___
___ ___ ___ ___ ___ ___     ___            ___               ___ ___ ___ ___ ___ ___
            ___ ___ ___                                          ___ ___ ___
)
